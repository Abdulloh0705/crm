# Base URL of the backend API. Leave unset to use the default '/api'
# (same-origin) — this is correct both for local dev (proxied by Vite to
# mock-server, see vite.config.js) and for the Vercel deployment (served by
# the /api serverless function, see api/index.js). Only set this if the
# frontend is deployed separately from its backend.
# VITE_API_BASE_URL=https://your-real-backend.example.com/api
